# Configuração de Ambiente — CourseSphere (Backend & Docker)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Segredos Backend (Configure via .env local ou GitHub Secrets na CI/CD)
OPENAI_API_KEY=sk-proj-sua-chave-aqui
FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com/
FIREBASE_CREDENTIALS_PATH=./credentials.json
# Opcional para CI/CD / Containers sem arquivo físico:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Variáveis de Ambiente Frontend (Vite — copiar para frontend/.env.local)
VITE_FIREBASE_API_KEY=sua-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000
